APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=3000
POSTGRES_DB=agentic_ai
POSTGRES_USER=agentic_ai
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+asyncpg://agentic_ai:change-this-local-password@localhost:5433/agentic_ai
DATABASE_ENABLED=true
REDIS_URL=redis://redis:6379/0
RABBITMQ_DEFAULT_USER=agentic_ai
RABBITMQ_DEFAULT_PASS=change-this-local-password
RABBITMQ_URL=amqp://agentic_ai:change-this-local-password@rabbitmq:5672/
QDRANT_URL=http://qdrant:6333
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-use
ENCRYPTION_KEY=replace-with-a-32-byte-base64-url-safe-key
OTEL_SERVICE_NAME=agentic-ai-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# Authentication (Google Cloud OAuth client, local callback by default)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
AUTH_COOKIE_SECURE=false

# LLM gateway (required in staging/production)
#
# The gateway speaks the OpenAI Responses API. Groq implements that API and is free at the
# tier this project targets, so the defaults below point there.
#   1. Create a key at https://console.groq.com/keys
#   2. Paste it into OPENAI_API_KEY (the variable name is provider-neutral in practice)
#
# Only openai/gpt-oss-120b and openai/gpt-oss-20b support strict json_schema output on Groq.
# Llama models fall back to json_object mode, which does not enforce the schema this codebase
# validates against - do not switch to them without changing the gateway.
#
# To use OpenAI directly instead: leave LLM_BASE_URL empty and set OpenAI model names.
LLM_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_MAX_OUTPUT_TOKENS=1500
LLM_RETRY_ATTEMPTS=2
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_REDACT_PII=true
AGENT_NODE_RETRY_ATTEMPTS=3
AGENT_MIN_CONFIDENCE=0.70
AGENT_AUTO_APPROVAL_CONFIDENCE=0.92

# Long-term memory
MEMORY_COLLECTION_NAME=organization_memory
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
MEMORY_DEFAULT_RETENTION_DAYS=365
MEMORY_RETRIEVAL_CANDIDATE_LIMIT=30
